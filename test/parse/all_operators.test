int main(void)
{
    int x = 10;
    int y = 5;
    int z = 0;
    int d = 2;
    int f = 1;

    // Arithmetic Operators
    z = x + y;
    z = x - y;
    z = x * y;
    z = x / y;
    z = x % y;

    // Assignment Operators
    x += 5;
    x -= 3;
    x *= 2;
    x /= 4;
    x %= 3;
    x >>= 3;
    x <<= 3;
    x ^= d;
    x &= d;
    x |= d;

    // Bitwise Operators
    z = d + f;
    z = d - f;
    z = d * f;
    z = d / f;
    z = d % f;
    z = d << f;
    z = d >> f;
    z = d ^ y;
    z = d & y;
    z = d | y;

    // Unary Operators
    z = ~d;
    ++z;
    --z;

    // Logical Operators
    int a = 1;
    int b = 0;
    int logicalAnd = a && b;
    int logicalOr = a || b;
    int logicalNot = !a;

    // Relational Operators
    int greaterThan = x > y;
    int lessThan = x < y;
    int greaterOrEqual = x >= y;
    int lessOrEqal = x <= y;
    int equalTo = x == y;
    int notEqual = x != y;
}
