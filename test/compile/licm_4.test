int i_feel_like_it;

int f(int a, int b, int n)
{
    &n; // budget noinline

    int s; s = 0;

    if (i_feel_like_it)
    {
        int i;
        for (i = 0; i < n; ++i)
            s += i * (a - b);
    }

    return s;
}

int main()
{
    i_feel_like_it = 1;
    return f(2, 3, 4) % 256;
}

